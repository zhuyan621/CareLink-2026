# Copy to .env locally and replace every placeholder.  Never commit the real file.
MAPFM_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
MAPFM_CLIENT_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_PASSWORD
MAPFM_AUDITOR_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_PASSWORD

# 32 random bytes encoded with base64 (AES-GCM key).
MAPFM_AES_KEY_B64=REPLACE_WITH_BASE64_KEY

# NCBI asks API clients to identify a tool and contact e-mail.
MAPFM_NCBI_TOOL=mapfm-competition-research
MAPFM_NCBI_EMAIL=REPLACE_WITH_CONTACT_EMAIL
NCBI_API_KEY=

# Required to authenticate a completed external-validation artifact.
MAPFM_VALIDATION_SIGNING_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
